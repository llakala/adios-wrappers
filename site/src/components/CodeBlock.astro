---
import { highlighter, kororaHighlighter } from "../lib/highlight";

interface Props {
  code: string;
  language: string;
}

const { code, language } = Astro.props;

let highlighted =
  language == "korora"
    ? kororaHighlighter(code)
    : highlighter.highlight(code, {
        language,
      }).value;
---

<pre><code class={`hljs hljs-${language}`} set:html={highlighted} /></pre>
